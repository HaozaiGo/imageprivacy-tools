{
  "name": "imageprivacy-tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "sync:workflow": "node scripts/sync-workflow.cjs",
    "check:workflow": "node scripts/sync-workflow.cjs --check",
    "test:workflow": "node tests/workflow.cjs",
    "test:workflow-cancel": "node tests/workflow-cancel.cjs",
    "test:crop": "node tests/resize-crop.cjs",
    "test:targets": "node tests/compress-target.cjs",
    "check": "node scripts/check-static.js",
    "audit:local": "node scripts/audit-sites.cjs",
    "audit:online": "node scripts/audit-sites.cjs --online",
    "test:tools": "node scripts/smoke-tools.cjs",
    "test:codecs": "node scripts/smoke-tools.cjs --codecs",
    "test:readiness": "node scripts/smoke-tools.cjs --readiness"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
